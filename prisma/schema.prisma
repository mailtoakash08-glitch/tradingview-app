// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORDERS TABLE
// ============================================
model Order {
  id               String    @id @default(cuid())
  orderId          String    @unique // ORD-xxx format
  externalOrderId  String?   // TWS/IBKR order ID for cancellation
  symbol           String
  strategy         String
  broker           String    // demo, ibkr, lightspeed
  action           String    // BUY, SELL
  orderType        String    // MKT, LMT, STP, TRAIL
  quantity         Int
  limitPrice       Float?
  stopPrice        Float?
  trailingAmount   Float?
  status           String    // PENDING, FILLED, CANCELLED, REJECTED
  filledQuantity   Int       @default(0)
  avgFillPrice     Float?
  outsideRth       Boolean   @default(false)
  submittedAt      DateTime  @default(now())
  filledAt         DateTime?
  cancelledAt      DateTime?
  rejectedAt       DateTime?
  errorMessage     String?

  @@index([broker, status])
  @@index([symbol, status])
  @@map("Order")
}

// ============================================
// POSITIONS TABLE
// ============================================
model Position {
  id               String    @id @default(cuid())
  symbol           String
  broker           String    // demo, ibkr, lightspeed
  strategy         String
  quantity         Int
  avgEntryPrice    Float
  currentPrice     Float
  unrealizedPnL    Float
  realizedPnL      Float     @default(0)
  isOpen           Boolean   @default(true)
  openedAt         DateTime  @default(now())
  closedAt         DateTime?

  @@index([symbol, broker, isOpen])
  @@map("Position")
}

// ============================================
// TRADES TABLE
// ============================================
model Trade {
  id               String    @id @default(cuid())
  orderId          String
  symbol           String
  broker           String
  strategy         String
  action           String    // BUY, SELL
  quantity         Int
  price            Float
  commission       Float     @default(0)
  pnl              Float?
  executedAt       DateTime  @default(now())

  @@index([symbol, executedAt])
  @@index([broker, executedAt])
  @@map("Trade")
}

// ============================================
// ACCOUNT SNAPSHOTS TABLE
// ============================================
model AccountSnapshot {
  id               String    @id @default(cuid())
  broker           String
  balance          Float
  equity           Float
  buyingPower      Float
  unrealizedPnL    Float
  realizedPnL      Float
  openPositions    Int
  dayTrades        Int       @default(0)
  timestamp        DateTime  @default(now())

  @@index([broker, timestamp])
  @@map("AccountSnapshot")
}

// ============================================
// SETTINGS TABLE
// ============================================
model Setting {
  id               String    @id @default(cuid())
  key              String    @unique
  value            String
  description      String?
  updatedAt        DateTime  @updatedAt

  @@map("Setting")
}

// ============================================
// LOGS TABLE
// ============================================
model Log {
  id               String    @id @default(cuid())
  level            String    // info, warn, error
  message          String
  context          String?
  metadata         String?   // JSON string
  timestamp        DateTime  @default(now())

  @@index([level, timestamp])
  @@map("Log")
}
